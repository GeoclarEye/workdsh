# 复制成 .env 后填写：cp deploy/docker/.env.example deploy/docker/.env
#
# 注意：compose.yml 里用了 ${VAR:?} 语法，这两项没设置时 compose 会直接拒绝启动，
# 而不是带着空值跑起来。

# 对外地址，必须是浏览器实际访问的地址（含协议）。
#   - 用它打印带令牌的登录链接（dsh 只知道自己在回环上，打印出来的地址对外不可用）
#   - 用它作为 dsh 的 --trusted-host，让 /api 的浏览器信任围栏认领这个 authority
# 必须经 HTTPS：DSH 浏览器端调用 crypto.randomUUID，该 API 仅在安全上下文可用。
WORKDSH_PUBLIC_URL=https://dsh.example.com

# 镜像名。指向 registry 即可从远端拉取，例如：
#   WORKDSH_IMAGE=ghcr.io/<你的账号>/workdsh-web:latest
WORKDSH_IMAGE=workdsh-web:local
